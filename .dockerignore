# Docker build context excludes.
#
# This MUST live at the build context root. CI builds with `context: .` and
# `file: build/Dockerfile`, and BuildKit only reads `<dockerfile>.dockerignore`
# or `<context>/.dockerignore` - a `.dockerignore` inside build/ is never applied.

# Git
.git/
.gitignore

# IDE
.vs/
.vscode/

# Docker
build/docker-compose*.yml

# .NET build artifacts. A local `dotnet build` of backend/Shared/CIPPSharp leaves an
# obj/ behind; the Dockerfile copies the project directory AFTER running its own
# `dotnet restore`, so a host-generated project.assets.json overwrites the container's
# restore and the following `--no-restore` build fails with NETSDK1064.
**/obj/

# Build artifacts
backend/Output/

# Frontend build artifacts (source is needed for multi-stage build)
frontend/node_modules/
frontend/.next/
frontend/out/

# Docs / non-runtime
docs/
.env
build/.env.example

# Locally generated by build-dev-modules (the image generates its own in a build stage);
# excluding keeps local backend/Config COPY layers cache-stable
backend/Config/function-parameters.json*

# NOTE: do NOT exclude *.md here. backend/Modules/CIPPTests ships ~573 markdown files
# that Invoke-ListTests.ps1 enumerates at runtime, so excluding them would silently
# strip the in-app compliance test documentation from the image.

# Locally generated static spec copy. The image builds its own and injects it into
# out/ after `yarn build`; letting a developer's copy into the build context would put
# it in the COPY frontend/ layer and invalidate the compile on every backend change.
frontend/public/openapi.json
