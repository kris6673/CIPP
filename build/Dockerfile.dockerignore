# Git
.git/
.gitignore

# IDE
.vs/
.vscode/

# Docker
build/docker-compose*.yml
build/.dockerignore

# Local dev overlays (compiled modules / writable manifest copies) - never ship these
build/.devmodules/
build/.devmanifests/

# Build artifacts
backend/Output/

# Frontend build artifacts (source is needed for multi-stage build)
frontend/node_modules/
frontend/.next/
frontend/out/

# Non-runtime
*.md
.env
build/.env.example

# Knowledge graphs (local dev tooling)
graphify/
graphify-out/

# Azure deployment templates and migration tooling (not runtime code)
deployment/

# Locally generated by build-dev-modules (the image generates its own in a build stage);
# excluding keeps local backend/Config COPY layers cache-stable
backend/Config/function-parameters.json*
